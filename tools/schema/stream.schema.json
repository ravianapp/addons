{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stream.schema.json",
  "title": "Stream (spec section 4)",
  "type": "object",
  "required": ["url"],
  "properties": {
    "url": { "type": "string", "pattern": "^https://" },
    "headers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "mime": { "type": "string" },
    "bitrate": { "type": "integer", "minimum": 1 },
    "video": { "type": "boolean" }
  }
}
