{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Addon manifest (spec section 3)",
  "type": "object",
  "required": ["id", "version", "name", "ravian", "resources", "types", "catalogs"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "ravian": { "const": 1 },
    "resources": {
      "type": "array",
      "items": { "enum": ["catalog", "meta", "stream", "recognize"] }
    },
    "types": {
      "type": "array",
      "items": { "enum": ["track", "album", "artist", "playlist", "podcast", "audiobook", "episode", "radio"] }
    },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "name"],
        "properties": {
          "type": { "enum": ["track", "album", "artist", "playlist", "podcast", "audiobook", "episode", "radio"] },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "scope": { "enum": ["persian", "international"] },
          "extra": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "isRequired": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "idPrefixes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scope": { "enum": ["persian", "international"] },
    "configurable": { "type": "boolean" }
  }
}
